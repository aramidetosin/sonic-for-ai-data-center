# The secrets the lab's scripts read. Copy each block into its file under /root/scd-secrets/ (mode 600, owner root)
# and set your own values. Nothing here is used as is.

# /root/scd-secrets/appliances.env
SONIC_USER=
SONIC_PW=
PA_USER=
PA_PW=
ONTAP_USER=
ONTAP_PW=
ONTAP_VSADMIN_PW=
ONTAP_DIAG_PW=
HOST_ADMIN_PW=
HOST_ROOT_PW=

# /root/scd-secrets/netapp.env (the ONTAP launcher's account)
USERNAME=
PASSWORD=

# /root/scd-secrets/host.env (the lab's Linux hosts)
HOST_ADMIN_PW=
HOST_ROOT_PW=

# /root/scd-secrets/f5-regkeys.txt: one BIG-IP VE registration key per line, one per unit (./f5.sh secrets writes lb-f5a.env and lb-f5b.env)
# /root/scd-secrets/ontap-licenses.txt: the ONTAP simulator's licence codes, one 28-letter code per line (ontap-setup.sh, both designs)
# one-cluster/.env (the one-cluster scripts): ONTAP_VSADMIN_PW=
# /root/pull-secret.json: your OpenShift pull secret
# ~/.ssh/id_ed25519.pub: the SSH public key the nodes accept
