configure terminal
interface Loopback 0
ip address 10.255.255.16/32
exit
interface Ethernet0
description uplink-spine1
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet1
description uplink-spine2
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet2
description uplink-spine3
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet3
description uplink-spine4
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
ip anycast-mac-address 00:00:5e:00:01:01
ip vrf Vrf-Mgmt
ip vrf Vrf-Ocp
ip vrf Vrf-Prod
evpn esi-multihoming
es-activation-delay 3000
exit
interface Vlan1503
description l3vni-mgmt
ip vrf forwarding Vrf-Mgmt
exit
interface Vlan1505
description l3vni-ocp
ip vrf forwarding Vrf-Ocp
exit
interface Vlan1501
description l3vni-prod
ip vrf forwarding Vrf-Prod
exit
interface Loopback 10
description inband-mgmt
ip vrf forwarding Vrf-Mgmt
ip address 172.16.255.16/32
exit
interface Loopback 11
description metallb-peering-vrf-prod
ip vrf forwarding Vrf-Prod
ip address 10.0.0.16/32
exit
interface Vlan101
description prod-nodes
ip vrf forwarding Vrf-Prod
mtu 9100
ip anycast-address 10.0.1.1/24
exit
interface Vlan102
description prod-probe-bastion
ip vrf forwarding Vrf-Prod
mtu 9100
ip anycast-address 10.0.2.1/24
exit
interface Vlan108
description gpu-nodes
ip vrf forwarding Vrf-Ocp
mtu 9100
ip anycast-address 10.0.8.1/24
exit
interface Vlan301
description mgmt-oob
ip vrf forwarding Vrf-Mgmt
mtu 9100
ip anycast-address 172.16.0.1/24
exit
interface PortChannel31 fast_rate
description prod-cp1-lag
mtu 9100
switchport access Vlan 101
system-mac 02:00:00:03:00:1f
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:03:1f
exit
exit
interface Ethernet4
description prod-cp1-lag-member
mtu 9100
channel-group 31
no shutdown
exit
interface PortChannel32 fast_rate
description prod-cp2-lag
mtu 9100
switchport access Vlan 101
system-mac 02:00:00:03:00:20
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:03:20
exit
exit
interface Ethernet5
description prod-cp2-lag-member
mtu 9100
channel-group 32
no shutdown
exit
interface PortChannel33 fast_rate
description prod-cp3-lag
mtu 9100
switchport access Vlan 101
system-mac 02:00:00:03:00:21
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:03:21
exit
exit
interface Ethernet6
description prod-cp3-lag-member
mtu 9100
channel-group 33
no shutdown
exit
interface PortChannel35 fast_rate
description gpu-worker1-lag
mtu 9100
switchport access Vlan 108
system-mac 02:00:00:03:00:23
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:03:23
exit
exit
interface Ethernet11
description gpu-worker1-lag-member
mtu 9100
channel-group 35
no shutdown
exit
interface PortChannel36 fast_rate
description gpu-worker2-lag
mtu 9100
switchport access Vlan 108
system-mac 02:00:00:03:00:24
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:03:24
exit
exit
interface Ethernet12
description gpu-worker2-lag-member
mtu 9100
channel-group 36
no shutdown
exit
interface PortChannel37 fast_rate
description gpu-worker3-lag
mtu 9100
switchport access Vlan 108
system-mac 02:00:00:03:00:25
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:03:25
exit
exit
interface Ethernet13
description gpu-worker3-lag-member
mtu 9100
channel-group 37
no shutdown
exit
interface PortChannel38 fast_rate
description gpu-worker4-lag
mtu 9100
switchport access Vlan 108
system-mac 02:00:00:03:00:26
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:03:26
exit
exit
interface Ethernet14
description gpu-worker4-lag-member
mtu 9100
channel-group 38
no shutdown
exit
interface PortChannel34 fast_rate
description probe-prod-lag
mtu 9100
switchport access Vlan 102
system-mac 02:00:00:03:00:22
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:03:22
exit
exit
interface Ethernet7
description probe-prod-lag-member
mtu 9100
channel-group 34
no shutdown
exit
interface Ethernet8
description prod-cp2-bmc
no shutdown
switchport access Vlan 301
exit
interface vxlan vtep1
source-ip 10.255.255.16
qos-mode pipe dscp 0
map vni 10101 vlan 101
map vni 10102 vlan 102
map vni 10108 vlan 108
map vni 10301 vlan 301
map vni 50003 vlan 1503
map vni 50003 vrf Vrf-Mgmt
map vni 50005 vlan 1505
map vni 50005 vrf Vrf-Ocp
map vni 50001 vlan 1501
map vni 50001 vrf Vrf-Prod
exit
router bgp 65003
router-id 10.255.255.16
log-neighbor-changes
timers 3 9
address-family ipv4 unicast
maximum-paths 8
network 10.255.255.16/32
exit
address-family l2vpn evpn
advertise-all-vni
exit
neighbor interface Ethernet0
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
neighbor interface Ethernet1
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
neighbor interface Ethernet2
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
neighbor interface Ethernet3
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
exit
router bgp 65003 vrf Vrf-Mgmt
router-id 10.255.255.16
log-neighbor-changes
address-family ipv4 unicast
redistribute connected
maximum-paths 8
exit
address-family l2vpn evpn
advertise ipv4 unicast
exit
exit
router bgp 65003 vrf Vrf-Ocp
router-id 10.255.255.16
log-neighbor-changes
address-family ipv4 unicast
redistribute connected
maximum-paths 8
exit
address-family l2vpn evpn
advertise ipv4 unicast
exit
exit
router bgp 65003 vrf Vrf-Prod
router-id 10.255.255.16
log-neighbor-changes
address-family ipv4 unicast
redistribute connected
maximum-paths 8
exit
address-family l2vpn evpn
advertise ipv4 unicast
exit
neighbor 10.0.1.21
remote-as 65030
timers 3 9
ebgp-multihop 3
update-source interface Loopback11
address-family ipv4 unicast
activate
exit
exit
neighbor 10.0.1.22
remote-as 65030
timers 3 9
ebgp-multihop 3
update-source interface Loopback11
address-family ipv4 unicast
activate
exit
exit
neighbor 10.0.1.23
remote-as 65030
timers 3 9
ebgp-multihop 3
update-source interface Loopback11
address-family ipv4 unicast
activate
exit
exit
exit
end
