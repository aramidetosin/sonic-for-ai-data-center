configure terminal
interface Loopback 0
ip address 10.255.255.32/32
exit
interface Ethernet0
description uplink-spine1
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet1
description uplink-spine2
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet2
description uplink-spine3
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet3
description uplink-spine4
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
ip anycast-mac-address 00:00:5e:00:01:01
ip vrf Vrf-Dev
ip vrf Vrf-Mgmt
ip vrf Vrf-Ocp
ip vrf Vrf-Prod
ip vrf Vrf-Svc
evpn esi-multihoming
es-activation-delay 3000
exit
interface Vlan1502
description l3vni-dev
ip vrf forwarding Vrf-Dev
exit
interface Vlan1503
description l3vni-mgmt
ip vrf forwarding Vrf-Mgmt
exit
interface Vlan1505
description l3vni-ocp
ip vrf forwarding Vrf-Ocp
exit
interface Vlan1501
description l3vni-prod
ip vrf forwarding Vrf-Prod
exit
interface Vlan1504
description l3vni-svc
ip vrf forwarding Vrf-Svc
exit
interface Loopback 10
description inband-mgmt
ip vrf forwarding Vrf-Mgmt
ip address 172.16.255.32/32
exit
interface Vlan401
description svc-dns-ntp
ip vrf forwarding Vrf-Svc
mtu 9100
ip anycast-address 10.250.0.1/24
exit
interface Vlan3001
description fw-transit-prod
ip vrf forwarding Vrf-Prod
ip address 10.254.1.2/29
exit
interface Vlan3002
description fw-transit-dev
ip vrf forwarding Vrf-Dev
ip address 10.254.2.2/29
exit
interface Vlan3003
description fw-transit-mgmt
ip vrf forwarding Vrf-Mgmt
ip address 10.254.3.2/29
exit
interface Vlan3004
description fw-transit-svc
ip vrf forwarding Vrf-Svc
ip address 10.254.4.2/29
exit
interface Vlan3014
description fw-transit-svc-prod
ip vrf forwarding Vrf-Svc
ip address 10.254.14.2/29
exit
interface Vlan3024
description fw-transit-svc-dev
ip vrf forwarding Vrf-Svc
ip address 10.254.24.2/29
exit
interface Vlan3009
description fw-transit-gpu
ip vrf forwarding Vrf-Ocp
ip address 10.254.9.2/29
exit
interface Vlan3007
description lb-transit-prod
ip vrf forwarding Vrf-Prod
ip address 10.254.7.1/29
exit
interface Vlan3008
description lb-transit-dev
ip vrf forwarding Vrf-Dev
ip address 10.254.7.1/29
exit
interface Vlan3011
description lb-transit-gpu
ip vrf forwarding Vrf-Ocp
ip address 10.254.7.1/29
exit
interface Ethernet7
description lb-f5a-trunk
mtu 9100
switchport trunk allowed Vlan 3007,3008,3011
no shutdown
exit
interface Ethernet8
description lb-f5b-trunk
mtu 9100
switchport trunk allowed Vlan 3007,3008,3011
no shutdown
exit
interface PortChannel91 fast_rate
description dns-ntp1-lag
mtu 9100
switchport access Vlan 401
system-mac 02:00:00:09:00:5b
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:09:5b
exit
exit
interface Ethernet4
description dns-ntp1-lag-member
mtu 9100
channel-group 91
no shutdown
exit
interface PortChannel92 fast_rate
description dns-ntp2-lag
mtu 9100
switchport access Vlan 401
system-mac 02:00:00:09:00:5c
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:09:5c
exit
exit
interface Ethernet5
description dns-ntp2-lag-member
mtu 9100
channel-group 92
no shutdown
exit
interface PortChannel93 fast_rate
description fw-pa-lag
mtu 9100
switchport trunk allowed Vlan 3001,3002,3003,3004,3014,3024,3009
system-mac 02:00:00:09:00:5d
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:09:5d
exit
exit
interface Ethernet6
description fw-pa-lag-member
mtu 9100
channel-group 93
no shutdown
exit
interface vxlan vtep1
source-ip 10.255.255.32
qos-mode pipe dscp 0
map vni 10401 vlan 401
map vni 13001 vlan 3001
map vni 13002 vlan 3002
map vni 13003 vlan 3003
map vni 13004 vlan 3004
map vni 13014 vlan 3014
map vni 13024 vlan 3024
map vni 13009 vlan 3009
map vni 50002 vlan 1502
map vni 50002 vrf Vrf-Dev
map vni 50003 vlan 1503
map vni 50003 vrf Vrf-Mgmt
map vni 50005 vlan 1505
map vni 50005 vrf Vrf-Ocp
map vni 50001 vlan 1501
map vni 50001 vrf Vrf-Prod
map vni 50004 vlan 1504
map vni 50004 vrf Vrf-Svc
exit
router bgp 65010
router-id 10.255.255.32
log-neighbor-changes
timers 3 9
address-family ipv4 unicast
maximum-paths 8
network 10.255.255.32/32
exit
address-family l2vpn evpn
advertise-all-vni
exit
neighbor interface Ethernet0
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
