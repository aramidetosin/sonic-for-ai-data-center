configure terminal
interface Loopback 0
ip address 10.255.255.2/32
exit
interface Ethernet0
description downlink-leaf1a-control
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
