configure terminal
interface Loopback 0
ip address 10.255.255.14/32
exit
interface Ethernet0
description uplink-spine1
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet1
description uplink-spine2
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet2
description uplink-spine3
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet3
description uplink-spine4
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
ip anycast-mac-address 00:00:5e:00:01:01
ip vrf Vrf-Mgmt
ip vrf Vrf-Ocp
evpn esi-multihoming
es-activation-delay 3000
exit
interface Vlan1503
description l3vni-mgmt
ip vrf forwarding Vrf-Mgmt
exit
interface Vlan1505
description l3vni-ocp
ip vrf forwarding Vrf-Ocp
exit
interface Loopback 10
description inband-mgmt
ip vrf forwarding Vrf-Mgmt
ip address 172.16.255.14/32
exit
interface Vlan108
description gpu-nodes
ip vrf forwarding Vrf-Ocp
mtu 9100
ip anycast-address 10.0.8.1/24
exit
interface Vlan301
description mgmt-oob
ip vrf forwarding Vrf-Mgmt
mtu 9100
ip anycast-address 172.16.0.1/24
exit
interface PortChannel21 fast_rate
description gpu-master3-lag
mtu 9100
switchport access Vlan 108
system-mac 02:00:00:02:00:15
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:02:15
exit
exit
interface Ethernet4
description gpu-master3-lag-member
mtu 9100
channel-group 21
no shutdown
exit
interface vxlan vtep1
source-ip 10.255.255.14
qos-mode pipe dscp 0
map vni 10108 vlan 108
map vni 10301 vlan 301
map vni 50003 vlan 1503
map vni 50003 vrf Vrf-Mgmt
map vni 50005 vlan 1505
map vni 50005 vrf Vrf-Ocp
exit
router bgp 65002
router-id 10.255.255.14
log-neighbor-changes
timers 3 9
address-family ipv4 unicast
maximum-paths 8
network 10.255.255.14/32
exit
address-family l2vpn evpn
advertise-all-vni
exit
neighbor interface Ethernet0
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
neighbor interface Ethernet1
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
neighbor interface Ethernet2
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
neighbor interface Ethernet3
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
exit
router bgp 65002 vrf Vrf-Mgmt
router-id 10.255.255.14
log-neighbor-changes
address-family ipv4 unicast
redistribute connected
maximum-paths 8
exit
address-family l2vpn evpn
advertise ipv4 unicast
exit
exit
router bgp 65002 vrf Vrf-Ocp
router-id 10.255.255.14
log-neighbor-changes
address-family ipv4 unicast
redistribute connected
maximum-paths 8
exit
address-family l2vpn evpn
advertise ipv4 unicast
exit
exit
end
write memory
