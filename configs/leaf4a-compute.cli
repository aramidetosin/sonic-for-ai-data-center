v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
exit
router bgp 65004 vrf Vrf-Dev
router-id 10.255.255.17
log-neighbor-changes
address-family ipv4 unicast
redistribute connected
maximum-paths 8
exit
address-family l2vpn evpn
advertise ipv4 unicast
exit
neighbor 10.0.1.21
remote-as 65030
timers 3 9
ebgp-multihop 3
update-source interface Loopback11
address-family ipv4 unicast
activate
exit
exit
neighbor 10.0.1.22
remote-as 65030
timers 3 9
ebgp-multihop 3
update-source interface Loopback11
address-family ipv4 unicast
activate
exit
exit
