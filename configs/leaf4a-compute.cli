configure terminal
interface Loopback 0
ip address 10.255.255.17/32
exit
interface Ethernet0
description uplink-spine1
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet1
description uplink-spine2
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet2
description uplink-spine3
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet3
description uplink-spine4
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
ip anycast-mac-address 00:00:5e:00:01:01
ip vrf Vrf-Dev
ip vrf Vrf-Mgmt
ip vrf Vrf-Ocp
evpn esi-multihoming
es-activation-delay 3000
exit
interface Vlan1502
description l3vni-dev
ip vrf forwarding Vrf-Dev
exit
interface Vlan1503
description l3vni-mgmt
ip vrf forwarding Vrf-Mgmt
exit
interface Vlan1505
description l3vni-ocp
ip vrf forwarding Vrf-Ocp
exit
interface Loopback 10
description inband-mgmt
ip vrf forwarding Vrf-Mgmt
ip address 172.16.255.17/32
exit
interface Loopback 11
description metallb-peering-vrf-dev
ip vrf forwarding Vrf-Dev
ip address 10.0.0.17/32
exit
interface Vlan201
description dev-nodes
ip vrf forwarding Vrf-Dev
mtu 9100
ip anycast-address 10.0.1.1/24
exit
interface Vlan202
description dev-probe-bastion
ip vrf forwarding Vrf-Dev
mtu 9100
ip anycast-address 10.0.2.1/24
exit
interface Vlan108
description gpu-nodes
ip vrf forwarding Vrf-Ocp
mtu 9100
ip anycast-address 10.0.8.1/24
exit
interface Vlan301
description mgmt-oob
ip vrf forwarding Vrf-Mgmt
mtu 9100
ip anycast-address 172.16.0.1/24
exit
interface PortChannel41 fast_rate
description dev-cp1-lag
mtu 9100
switchport access Vlan 201
system-mac 02:00:00:04:00:29
no shutdown
evpn ethernet-segment 00:00:00:00:00:00:00:00:04:29
exit
exit
interface Ethernet4
description dev-cp1-lag-member
mtu 9100
channel-group 41
no shutdown
exit
