no shutdown
switchport access Vlan 301
exit
interface Ethernet9
description dev-cp3-bmc
no shutdown
switchport access Vlan 301
exit
interface vxlan vtep1
source-ip 10.255.255.17
qos-mode pipe dscp 0
map vni 10201 vlan 201
map vni 10202 vlan 202
map vni 10108 vlan 108
map vni 10301 vlan 301
map vni 50002 vlan 1502
map vni 50002 vrf Vrf-Dev
map vni 50003 vlan 1503
map vni 50003 vrf Vrf-Mgmt
map vni 50005 vlan 1505
map vni 50005 vrf Vrf-Ocp
exit
router bgp 65004
router-id 10.255.255.17
log-neighbor-changes
timers 3 9
address-family ipv4 unicast
maximum-paths 8
network 10.255.255.17/32
exit
address-family l2vpn evpn
advertise-all-vni
exit
neighbor interface Ethernet0
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
neighbor interface Ethernet1
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
neighbor interface Ethernet2
v6only
remote-as external
capability extended-nexthop
address-family ipv4 unicast
activate
allowas-in 1
exit
address-family l2vpn evpn
activate
allowas-in 1
exit
exit
