configure terminal
interface Loopback 0
ip address 10.255.254.1/32
exit
interface Ethernet0
description downlink-rail-leaf1
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet1
description downlink-rail-leaf2
no shutdown
mtu 9100
ipv6 enable
no ipv6 nd suppress-ra
ipv6 nd ra-interval 5
exit
interface Ethernet2
description downlink-rail-leaf3
no shutdown
